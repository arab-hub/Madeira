+/* Madeira 0002: a hot thread's own bigger L1.
+ *
+ * ml363 capped every thread's L1 at 128 K entries (2 MB) because L1 inserts scatter over the
+ * whole array, so a big one dirties all its pages: at 16 MB for each of ~40 threads that was 1 GB
+ * against the jetsam limit. The L2 is off (DisableL2Cache), so each L1 miss is a C++ lookup. In
+ * Cyberpunk 2077 the five job threads and the main thread missed 30-80 K times a second each with
+ * their L1 at the cap, 250-460 K a second in all, for blocks compiled long before (conflicts in a
+ * direct-mapped table, not new code). A thread still missing MADEIRA_FEX_BIG_L1_RATE times a second
+ * (20000) at the cap gets one array of MADEIRA_FEX_BIG_L1 K entries (512 K, 8 MB) of its own, for
+ * at most MADEIRA_FEX_BIG_L1_THREADS threads (6): 48 MB at most, for the threads that need it.
+ * MADEIRA_FEX_BIG_L1=0 turns it off. [l1-big] lines show each one. */
+static std::atomic<int> IosBigL1Live {0};
+
+static uint64_t IosEnvU64(const char* Name, uint64_t Default) {
+  const char* V = getenv(Name);
+  if (!V || !*V) {
+    return Default;
+  }
+  char* End = nullptr;
+  const unsigned long long N = strtoull(V, &End, 10);
+  return (End && *End == '\0') ? N : Default;
+}
+
+static size_t IosBigL1Entries() {
+  static const size_t Entries = [] {
+    uint64_t K = IosEnvU64("MADEIRA_FEX_BIG_L1", 512);
+    if (K > 4096) {
+      K = 4096;
+    }
+    // A power of two, as the L1 mask needs.
+    return K ? size_t(1) << (63 - __builtin_clzll(K * 1024)) : size_t(0);
+  }();
+  return Entries;
+}
+
+static int IosBigL1MaxThreads() {
+  static const int Threads = [] {
+    const uint64_t N = IosEnvU64("MADEIRA_FEX_BIG_L1_THREADS", 6);
+    return int(N > 32 ? 32 : N);
+  }();
+  return Threads;
+}
+
+static uint64_t IosBigL1Rate() {
+  static const uint64_t Rate = IosEnvU64("MADEIRA_FEX_BIG_L1_RATE", 20000);
+  return Rate;
+}
+
+// The CPU's own timer, readable at EL0 (as Wine's RtlQueryPerformanceCounter reads it).
+static inline uint64_t IosTicks() {
+  uint64_t T;
+  __asm__ volatile("isb\n\tmrs %0, cntvct_el0" : "=r"(T)::"memory");
+  return T;
+}
+
+static inline uint64_t IosTickFrequency() {
+  uint64_t F;
+  __asm__ volatile("mrs %0, cntfrq_el0" : "=r"(F));
+  return F ? F : 24000000;
+}
