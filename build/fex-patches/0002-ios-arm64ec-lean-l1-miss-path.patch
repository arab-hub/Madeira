+// Madeira 0002: UpdateDynamicL1Stats's work, run on every 256th miss of this thread.
+void LookupCache::IosUpdateL1Stats(FEXCore::Core::InternalThreadState* Thread) {
+  { /* ml1124: process-wide L1-miss rate (every 2^20 misses, with the time), counted 256 at a time */
+    static std::atomic<uint64_t> IosL1Misses {0};
+    static std::atomic<uint64_t> IosL1LastTicks {0};
+    const uint64_t M = IosL1Misses.fetch_add(256, std::memory_order_relaxed) + 256;
+    if ((M & 0xfffff) == 0) {
+      const uint64_t Now = IosTicks();
+      const uint64_t Last = IosL1LastTicks.exchange(Now, std::memory_order_relaxed);
+      if (Last && Now > Last) {
+        LogMan::Msg::EFmt("[l1-miss] ml1124 {} L1 misses total, {:.0f}/s over the last 2^20", M,
+                          1048576.0 * double(IosTickFrequency()) / double(Now - Last));
+      }
+    }
+  }
+
+  const uint64_t Now = IosTicks();
+  const uint64_t Frequency = IosTickFrequency();
+  if (!IosLastPeriodTicks) {
+    IosLastPeriodTicks = Now;
+    L2L3CacheHits = 0;
+    return;
+  }
+  const uint64_t Elapsed = Now - IosLastPeriodTicks;
+  if (Elapsed < Frequency) {
+    return; // The heuristic's one-second period.
+  }
+
+  const double AveragePerSecond = double(L2L3CacheHits) * double(Frequency) / double(Elapsed);
+  if (AveragePerSecond >= DynamicL1CacheIncreaseCountHeuristic()) {
+    if (CurrentL1Entries < L1Capacity) {
+      CurrentL1Entries <<= 1;
+      L1PointerMask = CurrentL1Entries - 1;
+      // Since we're in C-code, this is safe to update here.
+      Thread->CurrentFrame->State.L1Mask = GetScaledL1PointerMask();
+    } else if (!IosBigL1Tried && AveragePerSecond >= double(IosBigL1Rate()) && IosBigL1Entries() > L1Capacity) {
+      IosWantBigL1 = true; // IosGrowL1, once no lock is held.
+    }
+  } else if (AveragePerSecond < DynamicL1CacheDecreaseCountHeuristic()) {
+    if (CurrentL1Entries > MIN_L1_ENTRIES) {
+      CurrentL1Entries >>= 1;
+      L1PointerMask = CurrentL1Entries - 1;
+
+      // Madvise the entries that we are dropping. Gives the memory back to the OS.
+      LookupCacheEntry* FirstZeroL1Entry = &reinterpret_cast<LookupCacheEntry*>(L1Pointer)[CurrentL1Entries];
+      const size_t ZeroMemorySize = (L1Capacity - CurrentL1Entries) * sizeof(LookupCacheEntry);
+      FEXCore::Allocator::VirtualDontNeed(FirstZeroL1Entry, ZeroMemorySize, false);
+
+      Thread->CurrentFrame->State.L1Mask = GetScaledL1PointerMask();
+    }
+  }
+
+  IosLastPeriodTicks = Now;
+  L2L3CacheHits = 0;
+}
+
+// Madeira 0002: gives this (hot) thread its own bigger L1. The owning thread, no lock held: the
+// allocation can reach FEX's own memory notifications, which take the invalidation lock.
+void LookupCache::IosGrowL1(FEXCore::Core::InternalThreadState* Thread) {
+  IosWantBigL1 = false;
+  if (IosBigL1Tried) {
+    return;
+  }
+  IosBigL1Tried = true;
+
+  const size_t Entries = IosBigL1Entries();
+  if (Entries <= L1Capacity) {
+    return;
+  }
+  const int Slot = IosBigL1Live.fetch_add(1, std::memory_order_relaxed);
+  if (Slot >= IosBigL1MaxThreads()) {
+    IosBigL1Live.fetch_sub(1, std::memory_order_relaxed);
+    static std::atomic<int> Refusals {0};
+    if (Refusals.fetch_add(1, std::memory_order_relaxed) < 4) {
+      LogMan::Msg::EFmt("[l1-big] madeira-0002 no bigger L1 for one more hot thread: {} have one (MADEIRA_FEX_BIG_L1_THREADS)",
+                        IosBigL1MaxThreads());
+    }
+    return;
+  }
+
+  const size_t Size = Entries * sizeof(LookupCacheEntry);
+  void* Mem = FEXCore::Allocator::VirtualAlloc(Size, false, true);
+  if (!Mem || Mem == reinterpret_cast<void*>(~uintptr_t {0})) {
+    IosBigL1Live.fetch_sub(1, std::memory_order_relaxed);
+    LogMan::Msg::EFmt("[l1-big] madeira-0002 {} MB for a bigger L1 not allocated; the thread keeps {} K entries", Size >> 20,
+                      L1Capacity >> 10);
+    return;
+  }
+  const size_t Stale = FEXCore::Allocator::ZeroScrub(Mem, Size);
+  ctx->SyscallHandler->MarkOvercommitRange(reinterpret_cast<uintptr_t>(Mem), Size);
+
+  {
+    // Another thread's InvalidateCache and ClearThreadLocalCaches write this L1 under the write lock.
+    auto lk = Shared->AcquireReadLock();
+    IosBigL1Base = reinterpret_cast<uintptr_t>(Mem);
+    IosBigL1Size = Size;
+    L1Pointer = IosBigL1Base;
+    L1Capacity = Entries;
+    CurrentL1Entries = Entries;
+    L1PointerMask = Entries - 1;
+    // The JIT reads both from the frame on every probe; this thread is in C++ now.
+    Thread->CurrentFrame->State.L1Pointer = L1Pointer;
+    Thread->CurrentFrame->State.L1Mask = GetScaledL1PointerMask();
+  }
+  LogMan::Msg::EFmt("[l1-big] madeira-0002 a hot thread's own L1: {} K entries ({} MB, {} stale bytes), {} of {} threads",
+                    Entries >> 10, Size >> 20, Stale, Slot + 1, IosBigL1MaxThreads());
+}
+#endif
